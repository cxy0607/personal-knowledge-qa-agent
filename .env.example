# =============================================
# 个人知识库 AI 问答工具 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值
# 注意：.env 已在 .gitignore 中，不会被提交到仓库
# =============================================

# ===== 阿里云百炼大模型 =====
# 在阿里云百炼控制台获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的百炼APIKey
# Agent 对话模型（需支持函数调用）
LLM_MODEL=qwen3.8-27b
# 向量化模型
EMBEDDING_MODEL=text-embedding-v3
